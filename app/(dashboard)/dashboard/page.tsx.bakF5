  { id: 'builder', label: 'Builder/Developer Inventory & Promotions', desc: 'New homes, communities, and incentives' },
  { id: 'events', label: 'Association Events & RSVPs', desc: 'SABOR, ABoR, GSABA, HBA invites and updates' },
];

