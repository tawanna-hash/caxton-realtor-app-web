# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Backup files from patch scripts
*.bak
*.bak[0-9]*
*.bakArticleB*
*.bakB2aFix*
*.bakMONTHS*
*.bakFIX*
*.bakRN*
*.bakREV
*.bakInc*
*.backup.ts
*.bak_*
.env*.local
*.bak.*

# Vercel env pulls — never commit (contain secrets)
.vercel.env.*

# iOS / Capacitor build outputs (the Xcode project itself IS committed;
# only the build artifacts and CocoaPods cache should be ignored)
ios/App/Pods/
ios/App/build/
ios/App/Podfile.lock
ios/DerivedData/
# NOTE: ios/App/App/public/ is generated by `npx cap sync ios` from the web build.
# It IS referenced by the Xcode project file, so we commit it (with a .gitkeep) to
# avoid build failures on fresh checkouts. Cap sync will overwrite the contents.
*.xcuserdatad
*.xcuserstate
xcuserdata/


# Playwright test artifacts
test-results/
playwright-report/
