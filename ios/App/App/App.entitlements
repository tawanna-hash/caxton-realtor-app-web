<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 'production' is the right value for TestFlight + App Store builds.
	     Switch to 'development' only when running on a sandbox (debug build
	     installed directly from Xcode against a personal Apple ID team). -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
