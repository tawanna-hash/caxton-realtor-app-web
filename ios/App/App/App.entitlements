<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 'production' is the right value for TestFlight + App Store builds.
	     Switch to 'development' only when running on a sandbox (debug build
	     installed directly from Xcode against a personal Apple ID team). -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Universal Links: lets iOS open https://realtynewsnow.app/* URLs
	     directly in this app instead of Safari. The matching
	     apple-app-site-association file is served at
	     https://realtynewsnow.app/.well-known/apple-app-site-association
	     and declares APP_ID 3JU7K7AMUY.app.realtynewsnow. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:realtynewsnow.app</string>
	</array>

	<!-- Sign in with Apple: required by ASAuthorizationAppleIDProvider.
	     Without this entitlement, the iOS plugin from
	     @capacitor-community/apple-sign-in returns an authorization error
	     and isPluginAvailable('SignInWithApple') still resolves true,
	     so the only way to know it's missing is the runtime failure.
	     Must also be enabled in the Apple Developer portal for the
	     bundle ID app.realtynewsnow under Team 3JU7K7AMUY. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
