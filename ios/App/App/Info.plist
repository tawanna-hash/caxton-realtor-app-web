<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Realty News Now</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Allow access to camera/photos for advertiser logo uploads, agreement signatures, etc. -->
	<key>NSCameraUsageDescription</key>
	<string>Realty News Now uses the camera so you can capture photos for listings, advertiser logos, and signed agreements.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Realty News Now needs access to your photo library so you can upload images for your listings, advertiser profile, and signed agreements.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Realty News Now needs permission to save images and signed PDF agreements to your photo library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Realty News Now uses your location to show nearby listings, market reports, and Houston-area real estate news relevant to you.</string>
	<!-- Face ID is offered as a fast sign-in for returning users. The web app already supports passkeys; the iOS shell wires the same flow through LocalAuthentication so the prompt feels native. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to sign in to your Realty News Now account faster without re-entering your password.</string>
	<!-- ATT prompt is shown only if/when we add a third-party tracking SDK that requires it. PostHog with anonymous IDs and masked inputs does NOT require ATT, but declaring the string here keeps App Review unblocked if we add an ad SDK later. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Allow tracking so Realty News Now can measure ad performance and show you relevant advertising partners across our publications.</string>
	<!-- App Transport Security: realtynewsnow.app already uses HTTPS so default ATS is fine.
	     We DO NOT enable NSAllowsArbitraryLoads. Listed below explicitly for App Review clarity. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<!-- iOS 14+ requires this URL scheme declaration for `Linking.canOpenURL` calls. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>mailto</string>
		<string>sms</string>
		<string>https</string>
	</array>
	<!-- Step 11: Export compliance. App uses only Apple-provided HTTPS / standard
	     iOS crypto (URLSession, WKWebView). Declaring this lets App Store Connect
	     skip the export compliance questionnaire on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Required when the app registers for remote notifications. Without this,
	     iOS will deliver the device token but the app cannot wake to process
	     silent notifications. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
