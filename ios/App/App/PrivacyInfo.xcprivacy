<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy Manifest for Realty News Now (app.realtynewsnow)

  Apple requires this file in every iOS app submitted after May 1, 2024.
  Declares: (1) whether the app tracks users across apps/websites,
  (2) which "Required Reason API" categories it uses and why,
  (3) which categories of user data it collects, why, and whether
  any of them are used for tracking.

  Notes on our setup:
    - We do NOT engage in cross-app/website tracking. PostHog session
      analytics is first-party, anonymous-by-default, with masked
      inputs and no advertising attribution SDKs. NSPrivacyTracking
      is therefore false and NSPrivacyTrackingDomains is empty.
    - Reasons selected below match Apple's "Describing use of required
      reason API" list (developer.apple.com/documentation/bundleresources/
      privacy_manifest_files/describing_use_of_required_reason_api).
    - Capacitor itself ships a privacy manifest; this file describes
      our own first-party usage. SDK manifests are merged at build time.
    - Data collection answers must stay in sync with the App Privacy
      "Nutrition Label" answers in App Store Connect. If you add a new
      SDK or collect a new field, update both.
-->
<plist version="1.0">
<dict>
  <!-- Cross-app/website tracking flag. False because we don't link our
       app's identifiers with third-party data for advertising. -->
  <key>NSPrivacyTracking</key>
  <false/>

  <!-- Domains that engage in tracking. Empty because NSPrivacyTracking=false.
       If we ever add an ad SDK, those domains MUST be listed here. -->
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <!-- Categories of user data collected by the app. The strings used here
       (e.g. NSPrivacyCollectedDataTypeEmailAddress) come from Apple's
       enumerated list. Each entry declares whether the value is linked
       to the user's identity, used for tracking, and the purposes. -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <!-- Email Address: signup, magic-link login, advertiser portal,
         subscribe form. Linked to identity, never used for tracking,
         used for app functionality (login, transactional email) and
         product personalization. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
      </array>
    </dict>

    <!-- Name: subscribe form, advertiser onboarding. Linked, not tracking. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeName</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Phone Number: subscribe form, advertiser contact. Linked, not tracking. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhoneNumber</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Physical Address: print subscription mailing, advertiser billing. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhysicalAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Payment Info: Stripe checkout for advertiser ad placements. We
         never see PAN/CVV (Stripe Elements iframes them). We retain
         only Stripe customer ID and last4. Not linked to the user
         beyond their advertiser account, never used for tracking. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePaymentInfo</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Photos or Videos: advertiser logo upload, signed-agreement images. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- User Generated Content (free-text fields on advertiser pages, etc.) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Coarse Location: optional, used for "near me" listings. Not
         persisted, not tracking. (Not Precise Location.) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Product Interaction: PostHog session events (page views, clicks).
         maskAllInputs is on, so form text is never captured. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeProductInteraction</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>

    <!-- Performance Data: client error reporting via PostHog activity-tracker. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePerformanceData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

    <!-- Crash Data: same source as Performance Data. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCrashData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>

    <!-- Device ID: PostHog anonymous distinct_id. Linked, not tracking. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeDeviceID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
  </array>

  <!-- "Required Reason API" usage. Apple has gated several APIs that
       have historically been used as fingerprinting signals. Anything
       that touches them must declare an approved reason code. -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <!-- UserDefaults / NSUserDefaults: Capacitor stores plugin
         preferences and the WKWebView session cookie defaults here.
         Reason CA92.1 = access info from same app. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>

    <!-- File timestamp: Capacitor file APIs (and any future @capacitor/filesystem
         use) read file modification dates. Reason C617.1 = inside app
         container, no external sharing. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
      </array>
    </dict>

    <!-- System boot time: PostHog uses it to compute relative session
         timestamps for analytics. Reason 35F9.1 = measure time on
         device for app function. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>35F9.1</string>
      </array>
    </dict>

    <!-- Disk space: Capacitor's filesystem plugin queries available
         storage before writing files. Reason E174.1 = display info
         about disk space to the user / write a file only when there's
         enough space. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>E174.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
